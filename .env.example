# Copier ce fichier en .env (jamais versionne) et completer.
# Une seule des deux options ci-dessous suffit.

# Option 1 : URL complete (prioritaire si definie)
DATABASE_URL=postgresql://hakili:motdepasse@localhost:5432/hakilisso

# Option 2 : variables separees, lues directement par psycopg2/libpq si
# DATABASE_URL n'est pas definie
# PGHOST=localhost
# PGPORT=5432
# PGUSER=hakili
# PGPASSWORD=motdepasse
# PGDATABASE=hakilisso
