# Configuration HAKILI LAB - copier en .env puis completer.
# Ne jamais commiter .env.

# URL PostgreSQL de production (prioritaire).
# Exemple local : postgresql://hakili_admin:motdepasse@localhost:5432/Hakili_compta
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/Hakili_compta

# Alternative si DATABASE_URL n'est pas definie :
# PGHOST=localhost
# PGPORT=5432
# PGUSER=hakili_admin
# PGPASSWORD=motdepasse
# PGDATABASE=Hakili_compta

# Journalisation optionnelle.
# HAKILI_LOG_FILE=/var/log/hakili/app.log

# Sauvegardes optionnelles.
# HAKILI_BACKUP_DIR=./backup/sauvegardes
# HAKILI_BACKUP_RETENTION_JOURS=30
# HAKILI_BACKUP_RCLONE_REMOTE=
