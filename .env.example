# Copier ce fichier en .env (jamais versionne) et completer.
# Une seule des deux options ci-dessous suffit.

# Option 1 : URL complete (prioritaire si definie)
DATABASE_URL=postgresql://hakili:motdepasse@localhost:5432/hakilisso

# Option 2 : variables separees, lues directement par psycopg2/libpq si
# DATABASE_URL n'est pas definie
# PGHOST=localhost
# PGPORT=5432
# PGUSER=hakili
# PGPASSWORD=motdepasse
# PGDATABASE=hakilisso

# Assistant IA (chat_config.py) : cle API Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Sauvegardes (backup/pg_backup.py), toutes optionnelles :
# HAKILI_BACKUP_DIR=./backup/sauvegardes
# HAKILI_BACKUP_RETENTION_JOURS=30
# Destination rclone pour la copie hors site des sauvegardes (fortement
# recommandee en production - voir backup/pg_backup.py). Laisser absente
# desactive simplement la copie distante, la sauvegarde locale continue.
# HAKILI_BACKUP_RCLONE_REMOTE=hakili-backup:hakili-lab/postgres

# Journalisation applicative (logic/donnees.py, app.py). Optionnelle :
# defaut hakili.log dans le dossier courant si absente.
# HAKILI_LOG_FILE=/var/log/hakili/app.log

# Service OCR externe (services/ocr_client.py). Comme toute valeur reelle,
# la cle se met dans .env (jamais versionne), jamais dans ce modele public.
# HAKILI_OCR_API_URL=https://exemple-ocr.onrender.com
# APP_API_KEY=votre-cle-ici